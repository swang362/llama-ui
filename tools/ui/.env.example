VITE_PUBLIC_APP_NAME='llama-ui'
# Dev server only: llama-server that `npm run dev` proxies API requests to.
VITE_PUBLIC_SERVER_ORIGIN='http://localhost:8033'
# Dev server only: extra console logging.
VITE_DEBUG='true'

# Defaults, used while the user leaves the setting empty. Users can override them in settings.
# Work in managed and unmanaged builds. A path like '/v1' is resolved against the page origin.
# Without a default API URL, an empty setting means llama-server.
VITE_PUBLIC_DEFAULT_API_URL=''
# Baked into the bundle and visible to every user.
VITE_PUBLIC_DEFAULT_API_KEY=''

# Managed mode: the UI fronts one fixed OpenAI-compatible API.
# API URL, custom JSON/CSS, llama-server only settings and the MCP proxy option are locked and hidden.
VITE_PUBLIC_MANAGED='false'
# Optional: API URL, defaults to <page origin>/v1. Overrides VITE_PUBLIC_DEFAULT_API_URL.
VITE_PUBLIC_MANAGED_API_URL=''
# Optional: lock and hide the API key. Overrides VITE_PUBLIC_DEFAULT_API_KEY.
# Baked into the bundle and visible to every user. Leave empty to let users enter their own key.
VITE_PUBLIC_MANAGED_API_KEY=''
