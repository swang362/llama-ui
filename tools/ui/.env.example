VITE_PUBLIC_APP_NAME='llama-ui'
VITE_DEBUG='true'
VITE_PUBLIC_SERVER_ORIGIN='http://localhost:8033'

# Managed mode: the UI fronts the OpenAI-compatible API served at <page origin>/v1.
# API URL, custom JSON/CSS and llama-server only settings are locked and hidden.
VITE_PUBLIC_MANAGED='false'
# Optional: lock the API key too. It is baked into the bundle and visible to every user.
# Leave empty to let users enter their own key.
VITE_PUBLIC_MANAGED_API_KEY=''
